# Frontend API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backend admin authentication (replace both placeholders before running)
ADMIN_USERS=admin:change-this-password
ADMIN_SECRET=replace-with-a-long-random-secret

# Optional: enables AI answers instead of the built-in fallback
ANTHROPIC_API_KEY=
